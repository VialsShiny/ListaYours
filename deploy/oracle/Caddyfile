# Caddy reverse proxy for the ListaYours API.
# API_DOMAIN comes from deploy/oracle/.env through docker-compose.prod.yml.
# Caddy obtains and renews the Let's Encrypt certificate automatically and
# redirects HTTP to HTTPS, as long as the DNS record points to this VM and
# ports 80/443 are reachable (https://caddyserver.com/docs/automatic-https, read 2026-11-08).

{$API_DOMAIN} {
	encode zstd gzip

	# Largest legitimate request is a 2 MB avatar upload; bigger bodies are cut before the API reads them.
	request_body {
		max_size 3MB
	}

	# Only the Vercel proxy (frontend/middleware.ts) knows the shared secret; everything else is
	# refused here, before the API, except the health check used by the VM itself.
	@direct {
		not path /health
		not header X-Proxy-Secret {$API_PROXY_SECRET}
	}
	respond @direct 403

	# Caddy sets X-Forwarded-For / X-Forwarded-Proto itself; the API uses X-Client-Ip from the
	# proxy for rate limiting once the secret matched (TRUST_PROXY_HEADERS stays false).
	reverse_proxy api:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
