# Production environment for the Oracle VM.
#   cp listayours.env.example .env && chmod 600 .env
# Fill in the values on the VM only. Never commit .env, never paste its content in a chat,
# a ticket or a log. Names only live in the repository.

# --- Caddy ------------------------------------------------------------------
# Public hostname of the API. Create the DNS A record (and AAAA if any) to the VM public IP first.
API_DOMAIN=api.example.com

# --- API (FastAPI) ----------------------------------------------------------
ENVIRONMENT=production

# SQLAlchemy URL. Managed Postgres (Neon/Supabase): keep sslmode=require (or verify-full).
# Compose expands `$` inside this file: URL-encode a password containing `$` (%24) or single-quote the value.
# Self-hosted (--profile local-db): postgresql+psycopg://listayours:<POSTGRES_PASSWORD>@db:5432/listayours
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# >= 32 characters, required in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   or: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=
JWT_EXPIRES_MINUTES=10080

# The account that registers with this e-mail becomes the wishlist owner.
OWNER_EMAIL=

# Comma-separated browser origins, no trailing slash. Must include the Vercel production URL
# and any custom frontend domain.
CORS_ORIGINS=https://listayours.vercel.app,https://www.example.com

# Scraper hardening
SCRAPE_TIMEOUT_SECONDS=90
SCRAPE_CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=20

# true ONLY because Caddy sits in front of the API and sets X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# --- Postgres (only with --profile local-db) ---------------------------------
POSTGRES_USER=listayours
POSTGRES_PASSWORD=
POSTGRES_DB=listayours
