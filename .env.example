# Copy to .env (never commit .env). Values here are placeholders, not secrets.

# --- Global ---------------------------------------------------------------
ENVIRONMENT=development

# --- API (FastAPI) --------------------------------------------------------
API_PORT=8000
# SQLAlchemy URL. docker compose provides the Postgres service "db".
DATABASE_URL=postgresql+psycopg://listayours:listayours@localhost:5432/listayours
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-value
JWT_EXPIRES_MINUTES=10080
# The account registered with this e-mail becomes the wishlist owner.
OWNER_EMAIL=owner@example.com
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Scraper hardening (behavior of the scraper itself is unchanged).
SCRAPE_TIMEOUT_SECONDS=90
SCRAPE_CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=20

# --- Postgres (docker compose) ---------------------------------------------
POSTGRES_USER=listayours
POSTGRES_PASSWORD=listayours
POSTGRES_DB=listayours
POSTGRES_PORT=5432

# --- Frontend (Next.js) ---------------------------------------------------
# URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL of the API as seen from the Next.js server (docker network). Optional.
API_INTERNAL_URL=http://api:8000
